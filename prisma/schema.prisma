generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlite"
  // Placeholder only. The real connection is provided by the libSQL driver
  // adapter (see prisma.config.ts for the CLI/schema engine, and src/lib/db.ts
  // for the runtime), which reads DATABASE_URL/TURSO_AUTH_TOKEN from the env.
  // Prisma's schema validation rejects a libsql:// URL here, so we keep a
  // static file: value that the adapter overrides.
  url          = "file:./prisma/dev.db"
  relationMode = "prisma"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  clearance    Int      @default(1)
  canPostScp   Boolean  @default(false)
  canFileIncident Boolean @default(false)
  // Filing experiment logs against an anomaly. Deliberately separate from
  // canPostScp: authoring containment documentation and running tests on a
  // contained anomaly are different jobs, held by different personnel.
  canLogTest   Boolean  @default(false)
  // Rewriting another member's personnel file. Previously implied by the RAISA
  // (L-R5) designation alone; now a grant in its own right, so recordkeeping
  // duty can be handed out without also handing out a clearance designation.
  canEditPersonnel Boolean @default(false)
  isOwner     Boolean  @default(false)
  // Co-Owner: owner-equivalent powers, held by at most MAX_CO_OWNERS members
  // at a time (see src/lib/roles.ts). Only the seeded owner can grant or
  // revoke it.
  isCoOwner    Boolean  @default(false)
  isAdmin      Boolean  @default(false)
  isStaff      Boolean  @default(false)
  // Helper: sits directly below Staff. Grants access to the General Assistance
  // ticket queue and nothing else. Only an Admin (or above) may grant it.
  isHelper     Boolean  @default(false)
  department   String?
  // Optional alternate clearance designation shown instead of the numeric label
  // (e.g. "E5", which carries the same rank-6 / L-O5 access). Null = normal.
  designation  String?
  personalFile String   @default("")
  suspended        Boolean  @default(false)
  suspendedReason  String?
  createdAt    DateTime @default(now())

  usedInvite      InviteCode?       @relation("InviteCodeUser")
  sentMessages     Message[]         @relation("MessageSender")
  receivedMessages Message[]         @relation("MessageRecipient")
  scpFiles        ScpFile[]
  broadcasts      Broadcast[]
  incidentReports IncidentReport[]
  secureMessages  SecureMessage[]
  clearanceRequests ClearanceRequest[] @relation("ClearanceRequestUser")
  reviewedRequests  ClearanceRequest[] @relation("ClearanceRequestReviewer")
  notesAbout       MemberNote[]      @relation("MemberNoteSubject")
  notesAuthored    MemberNote[]      @relation("MemberNoteAuthor")
  auditEntries     AuditLog[]        @relation("AuditActor")
  attachments      Attachment[]      @relation("AttachmentUploader")
  revisions        Revision[]        @relation("RevisionEditor")
  createdInvites   InviteCode[]      @relation("InviteCodeCreator")
  inviteRedemptions InviteRedemption[] @relation("InviteRedemptionUser")
  notifications      Notification[]      @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceUser")
  infractionsAbout   MemberInfraction[]  @relation("InfractionSubject")
  infractionsIssued  MemberInfraction[]  @relation("InfractionIssuer")
  scpAccessGrantsReceived ScpAccessGrant[] @relation("ScpAccessGrantUser")
  scpAccessGrantsIssued   ScpAccessGrant[] @relation("ScpAccessGrantGrantor")
  scpTestLogs      ScpTestLog[]   @relation("ScpTestLogAuthor")
  ticketsOpened    Ticket[]       @relation("TicketAuthor")
  ticketsClosed    Ticket[]       @relation("TicketCloser")
  ticketReplies    TicketReply[]  @relation("TicketReplyAuthor")
  hackRuns          HackRun[]   @relation("HackRunUser")
  hackRunsTraced    HackRun[]   @relation("HackRunTracer")
  hackGrants        HackGrant[] @relation("HackGrantUser")
  hackGrantsRevoked HackGrant[] @relation("HackGrantRevoker")
  hackDuelsDefended HackDuel[]  @relation("HackDuelDefender")
  conductRecords    ConductRecord[] @relation("ConductSubject")
}

// An IT support ticket. One table backs all three kinds because they share
// subject+body+status+thread and differ only in who may read them and, for an
// SCP access request, which file is being asked for.
//
// Visibility is NOT encoded here — it is derived from `type` by
// lib/tickets.ts, so the routing rules live in one place rather than being
// denormalized onto every row (and going stale when the rules change).
model Ticket {
  id        String   @id @default(cuid())
  // "general" | "bug" | "scp_access" — see TICKET_TYPES in lib/tickets.ts
  type      String
  subject   String
  body      String
  // "open" | "resolved" | "denied" — see TICKET_STATUSES
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime?
  closedAt  DateTime?
  // Closing note from the handler, shown to the requester.
  resolution String  @default("")

  authorId String
  author   User   @relation("TicketAuthor", fields: [authorId], references: [id])
  closedById String?
  closedBy   User?  @relation("TicketCloser", fields: [closedById], references: [id])

  // SCP access requests only: the file being requested and for how long.
  scpFileId      String?
  requestedDays  Int?

  replies TicketReply[]

  @@index([authorId])
  @@index([type, status])
  @@index([createdAt])
}

model TicketReply {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  authorId String?
  author   User?  @relation("TicketReplyAuthor", fields: [authorId], references: [id])
  // Denormalized so the thread survives the author's account being deleted.
  authorName String @default("")

  @@index([ticketId, createdAt])
}

// In-app alert surfaced by the header bell. Deliberately generic across
// triggers (new message, @mention, infraction filed) — `type` and `link`
// tell the UI what happened and where clicking it should go.
model Notification {
  id        String   @id @default(cuid())
  // "message" | "mention" | "infraction" — see NOTIFICATION_TYPES in lib/notifications.ts
  type      String
  body      String
  link      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
}

// Per-user, per-type notification opt-down. MUTED still logs the alert (so
// history is complete) but skips the unread badge/ping. SILENCED skips
// creating the row at all — a permanent "never tell me about this" opt-out.
// Absence of a row for a (userId, type) pair means fully on, the default.
model NotificationPreference {
  id       String  @id @default(cuid())
  type     String
  muted    Boolean @default(false)
  silenced Boolean @default(false)

  userId String
  user   User   @relation("NotificationPreferenceUser", fields: [userId], references: [id])

  @@unique([userId, type])
  @@index([userId])
}

// A formal disciplinary entry against a member, distinct from MemberNote:
// visible to the subject themselves (not just staff), and always notifies
// them when filed.
model MemberInfraction {
  id        String   @id @default(cuid())
  // "MINOR" | "MODERATE" | "MAJOR" | "SEVERE" — see INFRACTION_SEVERITIES in lib/infractions.ts
  severity  String
  reason    String
  createdAt DateTime @default(now())

  subjectId String
  subject   User   @relation("InfractionSubject", fields: [subjectId], references: [id])
  issuerId   String?
  issuer     User?  @relation("InfractionIssuer", fields: [issuerId], references: [id])
  // Denormalized so the record survives the issuer's account being deleted.
  issuerName String @default("")

  @@index([subjectId])
}

model MemberNote {
  id        String   @id @default(cuid())
  body      String
  flagged   Boolean  @default(false)
  createdAt DateTime @default(now())

  subjectId String
  subject   User   @relation("MemberNoteSubject", fields: [subjectId], references: [id])
  authorId  String
  author    User   @relation("MemberNoteAuthor", fields: [authorId], references: [id])
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  active    Boolean  @default(true)
  // Free-text label so staff can remember what a batch was minted for
  // ("winter recruitment", "MTF Nu-7 transfers").
  note      String   @default("")
  // How many registrations this code may back. 1 preserves the original
  // single-use behavior; higher values allow a shared batch code.
  maxUses   Int      @default(1)
  useCount  Int      @default(0)
  // Recorded when staff revoke a code, so the log explains itself later.
  revokedReason String @default("")
  createdAt DateTime @default(now())
  expiresAt DateTime?

  createdById String?
  createdBy   User?   @relation("InviteCodeCreator", fields: [createdById], references: [id])

  // First redeemer. Kept for the pre-existing one-to-one relation and the
  // "USED BY" display; the full list lives in `redemptions`.
  usedById String?  @unique
  usedBy   User?    @relation("InviteCodeUser", fields: [usedById], references: [id])

  redemptions InviteRedemption[]

  @@index([createdById])
}

// One row per registration backed by an invite code. Lets a multi-use code
// report exactly who it let in.
model InviteRedemption {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  inviteId String
  invite   InviteCode @relation(fields: [inviteId], references: [id])
  userId   String
  user     User       @relation("InviteRedemptionUser", fields: [userId], references: [id])

  @@index([inviteId])
  @@index([userId])
}

model Message {
  id          String   @id @default(cuid())
  subject     String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  // Root message id of the conversation this message belongs to. Set to the
  // message's own id for a thread-starting message; replies inherit the root's.
  threadId    String?

  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])

  @@index([threadId])
}

model ScpFile {
  id                String   @id @default(cuid())
  title             String
  body              String
  clearanceRequired Int
  classification    String   @default("Safe")
  createdAt         DateTime @default(now())
  // Null until the document is first edited. `revisionCount` counts stored
  // prior versions, so the UI can show "REV 3" without a join.
  updatedAt         DateTime?
  revisionCount     Int      @default(0)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  accessGrants ScpAccessGrant[]
  testLogs     ScpTestLog[]
}

// An experiment or test performed on an anomaly, appended to its file.
//
// Visibility is deliberately NOT stored here: a test log is readable by
// exactly whoever can read the parent ScpFile, so the existing clearance gate
// (and any temporary ScpAccessGrant) governs it with no second rule to keep
// in sync.
model ScpTestLog {
  id        String   @id @default(cuid())
  // Sequential per file, assigned at insert. Displayed as "TEST LOG 4" so the
  // archive reads like a lab notebook rather than a pile of cuids.
  sequence  Int      @default(1)
  procedure String
  result    String
  // Optional researcher commentary; the classic "Note:" line.
  notes     String   @default("")
  createdAt DateTime @default(now())

  scpFileId String
  scpFile   ScpFile @relation(fields: [scpFileId], references: [id])
  authorId   String?
  author     User?  @relation("ScpTestLogAuthor", fields: [authorId], references: [id])
  // Denormalized so the log survives the researcher's account being deleted.
  authorName String @default("")

  @@index([scpFileId, sequence])
  @@index([authorId])
}

// A staff-granted, time-limited exception letting one member read a specific
// SCP file below their normal clearance. Read access checks OR this in
// alongside the usual `clearanceRequired <= user.clearance` gate; once
// `expiresAt` passes the grant is simply ignored rather than deleted, so the
// record stays around for the audit trail.
model ScpAccessGrant {
  id        String    @id @default(cuid())
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  scpFileId String
  scpFile   ScpFile @relation(fields: [scpFileId], references: [id])
  userId    String
  user      User    @relation("ScpAccessGrantUser", fields: [userId], references: [id])
  grantedById String?
  grantedBy   User?  @relation("ScpAccessGrantGrantor", fields: [grantedById], references: [id])

  @@index([scpFileId, userId])
  @@index([userId])
  @@index([expiresAt])
}

// One intrusion attempt: a member's run at the five-stage terminal breach.
//
// The row doubles as the forensic record RAISA works from, which is why the
// intruder's clearance and department are SNAPSHOT here rather than joined at
// read time — a counter-intel case file has to stay truthful after the member
// is promoted or transferred.
model HackRun {
  id            String   @id @default(cuid())
  // "active" | "extracted" | "failed" | "abandoned"
  status        String   @default("active")
  // Highest stage fully cleared, 0-5. The banked tier derives from this.
  clearedStages Int      @default(0)
  stage         Int      @default(1)
  round         Int      @default(1)
  // Monotonic challenge counter. Every challenge records the cursor value it
  // was issued at, and a submission is accepted only while the two still
  // match. It never decrements, so a back-button, a refresh or a second tab
  // replaying an old nonce can never re-enter a stage already resolved — and
  // because the game for a round is drawn when that round is issued, it also
  // means the draw cannot be re-rolled.
  cursor        Int      @default(0)
  // True while the ladder waits on the EXTRACT / PUSH DEEPER decision.
  atCheckpoint  Boolean  @default(false)
  // Stage 5 carries a global cap on top of the per-round deadlines.
  stageDeadlineAt DateTime?
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  failReason    String   @default("")

  // Captured at breach time, released to RAISA one field per completed trace.
  ip              String @default("")
  terminal        String @default("")
  actorClearance  Int    @default(1)
  actorDepartment String @default("")

  // RAISA progressive reveal: 0 = anonymous .. 4 = fully identified.
  revealLevel      Int      @default(0)
  traceCursor      Int      @default(0)
  // Backs off a failed trace so the reveal ladder cannot be brute-forced.
  traceLockedUntil DateTime?
  traceById        String?
  traceBy          User?    @relation("HackRunTracer", fields: [traceById], references: [id])
  identifiedAt     DateTime?

  // RAISA's manual investigative workflow tag — "NEEDS_ACTION" |
  // "IN_PROGRESS" | "RESOLVED". Deliberately separate from `status` (the
  // intrusion's own outcome) and from the auto-derived technical resolution
  // in lib/counter-intel.ts (grant live/expired/revoked): this one records
  // what the desk has DONE about a case, not what the intrusion itself did.
  // Every new case starts at NEEDS_ACTION — RAISA has not looked at it yet.
  // Any RAISA member may move it, except into RESOLVED — see
  // canResolveCounterIntelCase() for why that step is L-R5 only.
  // Accumulated conduct suspicion across this run's intrusion rounds. Crossing
  // SUSPICION_FLAG_SCORE sets `flagged` below. Never fails a run on its own —
  // see lib/hack/suspicion.ts for why the evidence is advisory, not a verdict.
  suspicionScore Int @default(0)

  caseStatus String  @default("NEEDS_ACTION")
  // Anyone on the desk may flag a case for attention — independent of
  // caseStatus, so a case already IN_PROGRESS can still be flagged without
  // losing that state.
  flagged    Boolean @default(false)

  userId String
  user   User   @relation("HackRunUser", fields: [userId], references: [id])

  challenges HackChallenge[]
  grant      HackGrant?
  duel       HackDuel?

  @@index([userId, startedAt])
  @@index([status])
  @@index([startedAt])
}

// The counter-intrusion duel: one puzzle, two seats, one winner.
//
// A RAISA officer who catches a run while it is still `active` may engage it,
// and the intruder's console is interrupted with the SAME puzzle the officer
// is looking at. First correct answer wins. A duel always ends the run — the
// attacker extracts at Layer 3 minimum, or the run fails outright — which is
// why there is no "resume the intrusion" state anywhere in this model.
model HackDuel {
  id    String  @id @default(cuid())
  // One duel per run, enforced here rather than in application code: the
  // first officer to click ENGAGE claims the case, and a second one racing
  // them hits this constraint instead of opening a rival duel.
  runId String  @unique
  run   HackRun @relation(fields: [runId], references: [id])

  defenderId String
  defender   User   @relation("HackDuelDefender", fields: [defenderId], references: [id])

  // The single puzzle, drawn once and served to both seats.
  game     String
  // JSON the browser renders. Identical for both sides — that is the point.
  payload  String
  // JSON answer key. NEVER leaves the server, same rule as HackChallenge.
  solution String

  // Two nonces, one per seat. The nonce identifies BOTH the duel and which
  // seat is submitting, so no client ever sends a "side" parameter that would
  // have to be trusted.
  attackerNonce String @unique
  defenderNonce String @unique

  attackerAttemptsLeft Int @default(3)
  defenderAttemptsLeft Int @default(3)
  // Separates a stalemate (defender tried and neither solved it -> defender
  // wins, the intrusion was contained) from a walkover (defender engaged and
  // then abandoned the tab -> attacker wins).
  defenderSubmitted    Boolean @default(false)

  // The defender's clock starts at ENGAGE. The attacker's starts when their
  // poll first DELIVERS the duel to them, so poll latency can never eat the
  // intruder's time — see deliverDuel() in lib/hack/duel.ts.
  startedAt          DateTime  @default(now())
  deliveredAt        DateTime?
  attackerDeadlineAt DateTime?
  defenderDeadlineAt DateTime

  // "attacker" | "defender", null while the duel is live. Claimed with a
  // conditional updateMany on winner:null — two humans racing on one row is a
  // real race, and the compare-and-set is what makes the consequences
  // (issuing a grant, failing the run) fire exactly once.
  winner     String?
  resolvedAt DateTime?

  @@index([winner])
  @@index([startedAt])
  // purgeUser deletes by defenderId when a RAISA officer's account goes.
  @@index([defenderId])
}

// The read-only clearance a completed intrusion bought.
//
// Deliberately a separate model from HackRun (the record of the attempt) for
// the same reason ScpAccessGrant is separate from ScpFile: expiry and
// revocation are evaluated on every single request, so they get their own
// narrow indexed table. Rows are never deleted — an expired grant is simply
// ignored, and the row stays for the trail.
//
// This raises READ access only. Nothing derives authoring rights, role flags
// or redaction bypass from it; see authoringClearance() in lib/clearance.ts.
model HackGrant {
  id        String    @id @default(cuid())
  // 2-6. Never 7 — OWNER_CLEARANCE is what canBypassRedaction() keys off, and
  // no illicit grant may reach it.
  tier      Int
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  revokedById String?
  revokedBy   User?   @relation("HackGrantRevoker", fields: [revokedById], references: [id])

  userId String
  user   User    @relation("HackGrantUser", fields: [userId], references: [id])
  runId  String  @unique
  run    HackRun @relation(fields: [runId], references: [id])

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// One puzzle instance.
//
// `solution` is the security boundary of the whole feature: written at issue
// time, never selected into anything that reaches a browser. Every read that
// feeds the client goes through publicChallenge() in lib/hack/engine.ts.
model HackChallenge {
  id     String  @id @default(cuid())
  runId  String
  run    HackRun @relation(fields: [runId], references: [id])
  // "intrusion" (the member's ladder) | "trace" (RAISA's identification run).
  // One table because both sides run the identical engine.
  kind   String  @default("intrusion")
  game   String
  stage  Int
  round  Int
  cursor Int
  // Opaque handle the client echoes back. The client never learns the run id.
  nonce  String  @unique
  // JSON the client renders. Contains no solution material.
  payload  String
  // JSON answer key. NEVER leaves the server.
  solution String
  // Multi-guess games (ICE PASSWORD CRACK) burn attempts instead of failing
  // outright. Held here so a client that hides its own "out of attempts" UI
  // still gets refused.
  attemptsLeft Int      @default(1)
  issuedAt     DateTime @default(now())
  deadlineAt   DateTime
  answeredAt   DateTime?
  correct      Boolean?

  // Makes double-issue impossible at the DB level even under a two-tab race.
  @@unique([runId, kind, cursor])
  @@index([deadlineAt])
}

// One graded round's conduct evidence, from any of the three puzzle consoles.
//
// One table rather than columns bolted onto HackChallenge and HackDuel: the
// intrusion ladder, RAISA's trace ladder and both duel seats all produce the
// same shape of evidence, and the whole point is to be able to read it in one
// place — /admin/conduct — rather than joining three models to ask "who has
// been solving band-5 ciphers in four seconds".
//
// ANONYMITY: this row is keyed by userId, which is exactly the identity the
// counter-intel reveal ladder exists to protect. It is therefore readable ONLY
// by hasAdminPowers() — the tier that already deletes accounts and grants
// L-OMNI, and so learns nothing here it could not already learn. A RAISA
// officer never sees this table; what they see is HackRun.flagged, which
// carries a marker and no identity.
model ConductRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ConductSubject", fields: [userId], references: [id])
  // "intrusion" | "trace" | "duel_attacker" | "duel_defender"
  surface String
  game    String
  // The case this round belonged to. Nullable so a record outlives the case
  // being deleted from the desk rather than blocking that delete.
  runId   String?
  // Measured from the server's own issue/delivery stamp. Unforgeable, and the
  // heaviest-weighted signal in the score.
  elapsedMs Int
  correct   Boolean
  score     Int
  // JSON array of human-readable reasons, e.g. ["SOLVED IN 3.1S (FLOOR 12.0S)"].
  reasons   String @default("")
  // The raw client-reported telemetry blob. UNTRUSTED — a scripted client can
  // write whatever it likes here. Kept for a human to read, dropped after 30
  // days by pruneConductSignals().
  signals   String @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([score, createdAt])
  @@index([runId])
  @@index([createdAt])
}

model Broadcast {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime?
  revisionCount Int  @default(0)
  // Scheduling window. `publishAt` null (or in the past) means the directive
  // is live now; `expiresAt` null means it never stands down. Filtering is
  // done at query time rather than by a job, so a directive becomes visible
  // and disappears on its own without anything needing to run.
  publishAt DateTime?
  expiresAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([publishAt])
  @@index([expiresAt])
}

// Binary attachment stored directly in the database.
//
// Bytes live here rather than in object storage because the deployment has no
// blob store configured, and every attachment is deleted 14 days after upload
// — which caps how large the table can get. Reads filter on `expiresAt`, so an
// expired file stops being served the moment it lapses, whether or not the
// sweeper has physically removed the row yet.
model Attachment {
  id         String   @id @default(cuid())
  // "secure" (a secure-channel transmission) | "personnel" (a member dossier).
  // See ATTACHMENT_ENTITIES in lib/attachments.ts.
  entityType String
  entityId   String
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())
  // Null means the attachment never expires. Personnel-dossier evidence is
  // permanent; secure-channel attachments carry a real expiry.
  expiresAt  DateTime?

  uploaderId   String?
  uploader     User?   @relation("AttachmentUploader", fields: [uploaderId], references: [id])
  // Denormalized so the caption survives the uploader's account deletion.
  uploaderName String  @default("")

  @@index([entityType, entityId])
  @@index([expiresAt])
  @@index([uploaderId])
}

model ClearanceRequest {
  id              String    @id @default(cuid())
  requestedLevel  Int
  reason          String
  status          String    @default("pending")
  reviewNote      String?
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?

  userId       String
  user         User     @relation("ClearanceRequestUser", fields: [userId], references: [id])
  reviewedById String?
  reviewedBy   User?    @relation("ClearanceRequestReviewer", fields: [reviewedById], references: [id])
}

// Secure communications channel for L-5+ clearance. A single shared, encrypted-
// styled feed that only cleared personnel can read or post to.
model SecureMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

// Single-row site configuration (id is always "singleton"). Controls the
// owner-triggered maintenance lockdown and its bypass access code.
model SiteConfig {
  id                 String  @id @default("singleton")
  maintenanceMode    Boolean @default(false)
  bypassCode         String  @default("")
  maintenanceMessage String  @default("")
  // Optional scheduled end for the lockdown. When set, the maintenance notice
  // shows a public countdown and the site unlocks itself the moment this passes
  // — no job required, the gate simply re-reads the clock on each request. Null
  // means the lockdown stays up until an owner turns it off by hand.
  lockdownUntil      DateTime?

  // --- OMEGA AUTHORITY ------------------------------------------------------
  // A harder gate than maintenanceMode, and deliberately a separate flag rather
  // than a mode of it: there is no bypass code, and it darkens /login too, so
  // the two must never be confusable. Only the seeded root owner can set or
  // clear it, and only they can still reach the site while it is up.
  shutdownMode       Boolean @default(false)
  shutdownMessage    String  @default("")
  shutdownAt         DateTime?

  // Two-phase arming for the destructive controls. Held here rather than in a
  // cookie or client state so the mandatory delay is enforced by the server: a
  // crafted request cannot skip a countdown it never saw.
  omegaArmedOp       String?
  omegaArmedAt       DateTime?
  omegaArmedBy       String?
}

model IncidentReport {
  id                String   @id @default(cuid())
  title             String
  location          String   @default("")
  body              String
  severity          String   @default("Minor")
  clearanceRequired Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime?
  revisionCount     Int      @default(0)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

// Immutable snapshot of a document taken immediately before an edit lands, so
// the archive can show what a file used to say and who changed it.
//
// Deliberately generic across ScpFile / IncidentReport / Broadcast: the three
// share title+body and differ only in a couple of metadata fields, which are
// stashed as JSON in `meta` rather than adding three near-identical tables.
model Revision {
  id         String   @id @default(cuid())
  // "scp" | "incident" | "broadcast" — see REVISION_ENTITIES in lib/revisions.ts
  entityType String
  entityId   String
  title      String
  body       String
  // JSON blob of the type-specific fields at snapshot time (classification,
  // severity, location, clearanceRequired).
  meta       String   @default("{}")
  // Optional note the editor left explaining the change.
  reason     String   @default("")
  createdAt  DateTime @default(now())

  editorId   String?
  editor     User?    @relation("RevisionEditor", fields: [editorId], references: [id])
  // Denormalized so the history survives the editor's account being deleted.
  editorName String   @default("")

  @@index([entityType, entityId, createdAt])
  @@index([editorId])
}

// Append-only record of privileged actions. Actor name and target name are
// denormalized because the log has to stay readable after the accounts it
// references are deleted.
model AuditLog {
  id         String   @id @default(cuid())
  // Dot-namespaced verb, e.g. "user.clearance.set" — see AUDIT_ACTIONS.
  action     String
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorName  String   @default("")
  targetType String   @default("")
  targetId   String   @default("")
  targetName String   @default("")
  // Human-readable one-line description rendered directly in the admin log.
  summary    String   @default("")
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@index([targetId])
}

// Throttling ledger for credential and invite-code guessing. One row per
// attempt; `key` scopes the bucket (e.g. "login:agent@foundation.scp",
// "invite:203.0.113.4"). Rows are pruned opportunistically once expired.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}
